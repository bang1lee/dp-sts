{
  "name": "studio",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/studio/src",
  "tags": [],
  "// targets": "to see all targets run: nx show project studio --web",
  "targets": {
    "build": {
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/compositions/**/*.json",
        {
          "externalDependencies": [
            "vite"
          ]
        }
      ]
    },
    "direction-test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx --test tools/recipe-film-direction.spec.ts"
      },
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/tools/recipe-film-direction.spec.ts",
        "{workspaceRoot}/assets/original-kit/manifest.json"
      ]
    }
  }
}
