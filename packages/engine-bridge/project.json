{
  "name": "engine-bridge",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/engine-bridge/src",
  "projectType": "library",
  "tags": [],
  "// targets": "to see all targets run: nx show project engine-bridge --web",
  "targets": {
    "adapters": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node tools/engine-bridge-build.mjs"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["adapters"],
      "cache": false,
      "options": {
        "command": "pnpm exec tsx --test tools/engine-bridge.spec.ts"
      }
    },
    "bundle": {
      "executor": "nx:run-commands",
      "dependsOn": ["adapters"],
      "cache": false,
      "options": {
        "command": "uv run --locked --package ambient-media python -m ambient_media.engine_bundle"
      }
    }
  }
}
